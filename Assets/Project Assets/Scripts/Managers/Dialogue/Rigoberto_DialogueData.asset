  m_Script: {fileID: 11500000, guid: ef4bf9b3843739b4aae753b920ec9aba, type: 3}
  m_Name: Rigoberto_DialogueData
  m_EditorClassIdentifier: 
  speakDialogue:
  - isPlayerSpeaking: 0
    dialogueText: My sack is more torn than my dreams... Kids these days are heavier.
  leaveDialogue:
  - isPlayerSpeaking: 0
    dialogueText: I'll come back once the sack is heavier.
  wrongItemDialogue:
  - isPlayerSpeaking: 0
    dialogueText: It's not what I needed.
  correctItemDialogue:
  - isPlayerSpeaking: 0
    dialogueText: "That superhero guy seems blind, and I haven\u2019t heard him speak
      either\u2014how does he fight crime like that?"
  sellItemDialogue:
  - isPlayerSpeaking: 0
    dialogueText: Good
