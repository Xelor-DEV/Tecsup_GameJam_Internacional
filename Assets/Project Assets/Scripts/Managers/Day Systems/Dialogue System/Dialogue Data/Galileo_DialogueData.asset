  speakDialogue:
  - lines:
    - isPlayerSpeaking: 0
      dialogueText: "I'm looking for The Art of War by Poseidon. They say it's deep\u2026
        just like me."
  leaveDialogue:
  - isPlayerSpeaking: 0
    dialogueText: I dive into the darkness, see you later.
  wrongItemDialogue:
  - isPlayerSpeaking: 0
    dialogueText: Maybe too deep for me.
  correctItemDialogue:
  - isPlayerSpeaking: 0
    dialogueText: "That ghost had a stained towel\u2026 spirits don\u2019t use bath
      textiles\u2026 or do they?"
  sellItemDialogue:
  - isPlayerSpeaking: 0
    dialogueText: "Good \n"
